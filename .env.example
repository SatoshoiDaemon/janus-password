# Configuração do Gestor de Senhas

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
CORS_ORIGINS=
RATELIMIT_STORAGE_URI=memory://

# Database: SQLite is the default local mode.
# Use DATABASE_URL for a complete SQLAlchemy URL when an external database is desired.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database?sslmode=require
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database
DB_ENGINE=sqlite
DB_PATH=database.db
# Alternative to DATABASE_URL:
# DB_ENGINE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=password_manager
# DB_USER=app_user
# DB_PASSWORD=change-me
# DB_SSL_MODE=require
# DB_SSL_CA=/absolute/path/to/ca.pem

# Server
HOST=127.0.0.1
PORT=5000

# Security
SESSION_TIMEOUT=604800  # 7 dias em segundos
PUBLIC_NOTE_TTL_DAYS=7

# Independent vault unlock timeout in seconds (login lifetime is separate).
VAULT_TIMEOUT=300
# Optional encrypted pre-write recovery snapshots; manual export captures latest state.
# JANUS_BACKUP_DIR=/absolute/path/to/janus-backups
JANUS_BACKUP_INTERVAL=3600
JANUS_BACKUP_RETENTION=10
