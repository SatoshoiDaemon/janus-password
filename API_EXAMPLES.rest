# Local API; replace placeholders with values from your local session.
@baseUrl = http://127.0.0.1:5000
@csrf = REPLACE_WITH_CSRF_TOKEN

### Register (email is local account metadata; no remote account is created)
POST {{baseUrl}}/api/register
Content-Type: application/json

{"username":"local-user","email":"local@example.test","password":"login-password","password_confirm":"login-password"}

### Login (does not unlock vault; retain session cookie)
POST {{baseUrl}}/api/login
Content-Type: application/json

{"username":"local-user","password":"login-password"}

### Get CSRF token using same session cookie; paste value into @csrf
GET {{baseUrl}}/api/csrf-token

### Check unlock status (does not extend idle timeout)
GET {{baseUrl}}/api/vault/status

### Unlock or initialize/migrate the vault
POST {{baseUrl}}/api/vault/unlock
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{"master_password":"independent-master-password"}

### Add a credential; no master password in writes
POST {{baseUrl}}/api/credentials
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{"site_name":"Example","login":"alice","password":"stored-secret"}

### List metadata, unlocked vault required
GET {{baseUrl}}/api/credentials

### Reveal using POST, not GET with a body
POST {{baseUrl}}/api/credentials/1/reveal
X-CSRF-Token: {{csrf}}

### Export complete encrypted account vault
POST {{baseUrl}}/api/vault/export
X-CSRF-Token: {{csrf}}

### Restore: replace backup with the full exported JSON; use an empty local account
POST {{baseUrl}}/api/vault/restore
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{"master_password":"independent-master-password","backup":{}}

### Change master password; invalidates all existing unlocks
POST {{baseUrl}}/api/vault/change-password
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{"current_password":"independent-master-password","new_password":"another-strong-master-password"}

### Reveal note (requires unlocked vault and independent note password)
POST {{baseUrl}}/api/notes/1/reveal
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{"note_password":"note-password"}

### Explicit lock; login remains active
POST {{baseUrl}}/api/vault/lock
X-CSRF-Token: {{csrf}}

### Logout; removes unlock and login session
POST {{baseUrl}}/api/logout
X-CSRF-Token: {{csrf}}
